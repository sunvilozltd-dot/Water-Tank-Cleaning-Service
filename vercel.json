{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "cleanUrls": true,
  "crons": [
    {
      "path": "/api/indexnow?cron=1",
      "schedule": "0 3 * * *"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "SAMEORIGIN",
        "X-XSS-Protection": "1; mode=block",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "Permissions-Policy": "camera=(), microphone=(), geolocation=()"
      },
      "continue": true
    },
    {
      "src": "/assets/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable",
        "CDN-Cache-Control": "public, max-age=31536000, immutable",
        "Vercel-CDN-Cache-Control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "src": "/videos/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=604800, stale-while-revalidate=86400",
        "CDN-Cache-Control": "public, max-age=604800, stale-while-revalidate=86400",
        "Vercel-CDN-Cache-Control": "public, max-age=604800, stale-while-revalidate=86400"
      },
      "continue": true
    },
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.sunvilozcleancare.com"
        }
      ],
      "status": 301,
      "headers": {
        "Location": "https://sunvilozcleancare.com/$1"
      }
    },
    {
      "src": "^/water-tank-cleaning-service/?$",
      "status": 301,
      "headers": { "Location": "/services/water-tank-cleaning" }
    },
    {
      "src": "^/pipeline-cleaning-service/?$",
      "status": 301,
      "headers": { "Location": "/services/pipeline-cleaning" }
    },
    {
      "src": "^/services/pipe-line-cleaning/?$",
      "status": 301,
      "headers": { "Location": "/services/pipeline-cleaning" }
    },
    {
      "src": "^/services/underground-tank-cleaning/?$",
      "status": 301,
      "headers": { "Location": "/services/underground-water-tank-cleaning" }
    },
    {
      "src": "^/services/overhead-water-tank-cleaning/?$",
      "status": 301,
      "headers": { "Location": "/services/overhead-tank-cleaning" }
    },
    {
      "src": "^/areas/?$",
      "status": 301,
      "headers": { "Location": "/service-areas" }
    },
    {
      "src": "^/areas/([^/]+)/?$",
      "status": 301,
      "headers": { "Location": "/service-areas/$1" }
    },
    {
      "src": "^/projects/?$",
      "status": 301,
      "headers": { "Location": "/portfolio" }
    },
    {
      "src": "^/terms-and-conditions/?$",
      "status": 301,
      "headers": { "Location": "/terms" }
    },
    {
      "src": "^/pricing/?$",
      "status": 301,
      "headers": { "Location": "/get-quote" }
    },
    {
      "src": "^/services-faq/?$",
      "status": 301,
      "headers": { "Location": "/faq" }
    },
    {
      "src": "^/quote/?$",
      "status": 301,
      "headers": { "Location": "/get-quote" }
    },
    {
      "src": "^/tips/?$",
      "status": 301,
      "headers": { "Location": "/blog" }
    },
    {
      "src": "^/tips/([^/]+)/?$",
      "status": 301,
      "headers": { "Location": "/blog/$1" }
    },
    {
      "src": "^/sitemap\\.xml$",
      "dest": "/api/sitemap"
    },
    {
      "src": "^/llms\\.txt$",
      "dest": "/api/llms"
    },
    {
      "src": "^/$",
      "dest": "/api/render?path=/"
    },
    {
      "src": "^/((?:blog|service-areas|services|about|contact|faq|portfolio|get-quote|privacy-policy|terms)(?:/.*)?)$",
      "dest": "/api/render?path=/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/admin(?:/.*)?$",
      "dest": "/index.html"
    },
    {
      "src": "^/login/?$",
      "dest": "/index.html"
    },
    {
      "src": "^/(?!api/|assets/|videos/|.*\\.[a-zA-Z0-9]{1,8}$)(.*)$",
      "dest": "/api/render?path=/$1"
    }
  ]
}
