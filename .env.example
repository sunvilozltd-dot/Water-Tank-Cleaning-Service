# ==============================================================================
# SUNVILOZ CLEAN CARE — ENVIRONMENT CONFIGURATION EXAMPLE
# Copy to .env in production deployment or set these in your hosting environment
# ==============================================================================

# 1. Supabase Database Integration (Optional for local mode, required for remote cloud database)
# Found under: Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-public-anon-key-here"

# 2. Analytics & Conversion Tracking (Optional: leave blank if not yet configured)
# Google Analytics 4 Measurement ID (e.g., G-XXXXXXXXXX)
VITE_GA_MEASUREMENT_ID=""

# Meta (Facebook) Pixel ID (e.g., 123456789012345)
VITE_META_PIXEL_ID=""

# 3. Application Hosting URL
APP_URL="https://sunvilozcleancare.com"

# 4. AI Studio System Secrets (Injected automatically in build environment)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
