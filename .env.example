# ==============================================================================
# SUNVILOZ CLEAN CARE — ENVIRONMENT CONFIGURATION EXAMPLE
# ==============================================================================
# Note on Required vs Optional variables:
# - Client variables MUST be prefixed with VITE_ to be available in the browser.
# - Server-only secrets (SUPABASE_SERVICE_ROLE_KEY, INDEXNOW_KEY) MUST NEVER use VITE_.
# ==============================================================================

# 1. Production Canonical Domain (Recommended on Vercel)
VITE_SITE_URL="https://sunvilozcleancare.com"

# 2. Supabase Public Client Configuration (Current Project Values)
# Note: The anon key is Supabase's public client key protected by Row Level Security (RLS).
VITE_SUPABASE_URL="https://ldzhzeyeuthdkobzxzlm.supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Imxkemh6ZXlldXRoZGtvYnp4emxtIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTM1NDI3NjAsImV4cCI6MjEwOTExODc2MH0.lwdie6wt0M8nxjgeo0Z_DfEiYz5iKc5pWa5St9qOazY"

# 3. Analytics & Conversion Tracking (OPTIONAL)
# Leave empty if not configured yet; tracking remains safely disabled and site/build will succeed.
VITE_GA_MEASUREMENT_ID=""
VITE_META_PIXEL_ID=""

# 4. IndexNow Verification & Submission (OPTIONAL — Server-Side Only)
# Provide your own 8-128 character alphanumeric/hyphen key (e.g. from Bing Webmaster Tools).
# Leave empty to keep IndexNow safely disabled; build & main website work normally without it.
# Never prefix with VITE_. When set during Vercel build, /<INDEXNOW_KEY>.txt is generated automatically.
INDEXNOW_KEY=""

# 5. Supabase Service Role Key (OPTIONAL — Server-Side Secret Only, NEVER use VITE_)
# Leave empty unless specifically needed for privileged backend tasks.
# Normal admin operations already work via Supabase Auth + anon key + strict RLS policies.
SUPABASE_SERVICE_ROLE_KEY=""

# 6. Authenticated Static Rebuild Hook & IndexNow Outbox Cron Secret (OPTIONAL — Server-Side Only)
# If set, Admin Panel's "Trigger Static Rebuild" calls this Vercel Deploy Hook after DB publish.
VERCEL_DEPLOY_HOOK_URL=""
# Set a strong random secret (e.g. 32+ chars) in Vercel Environment Variables to authenticate /api/indexnow?cron=1.
# Requires SUPABASE_SERVICE_ROLE_KEY & INDEXNOW_KEY to activate automatic outbox retries.
CRON_SECRET=""
# Optional: set to "true" only if invoking /api/indexnow?cron=1 from an external scheduler outside Vercel Cron.
INDEXNOW_CRON_ENABLED=""
