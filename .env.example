# ==============================================================================
# SUNVILOZ CLEAN CARE — ENVIRONMENT CONFIGURATION EXAMPLE
# ==============================================================================
# Required vs Optional rules:
# - Browser/Vite variables MUST be prefixed with VITE_.
# - Server/API/Prerender reads SUPABASE_URL / SUPABASE_ANON_KEY and falls back to VITE_*.
# - Server-only secrets (SUPABASE_SERVICE_ROLE_KEY, INDEXNOW_KEY, CRON_SECRET)
#   MUST NEVER use VITE_ so they never enter client bundles.
# ==============================================================================

# 1. Production Canonical Domain (Recommended on Vercel)
VITE_SITE_URL="https://sunvilozcleancare.com"

# 2. Supabase Configuration (Required for Browser, SSR, Sitemap & Build Prerender)
# Copy these exact values from Supabase Dashboard -> Project Settings -> API.
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
# Optional server-side overrides (defaults to VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY if omitted)
SUPABASE_URL=""
SUPABASE_ANON_KEY=""

# 3. Build Prerender Strictness & Query Timeout (OPTIONAL)
# Automatically strict on Vercel (VERCEL=1). Set STRICT_PRERENDER=true to fail local production builds on DB errors.
STRICT_PRERENDER=""
SUPABASE_QUERY_TIMEOUT_MS="6000"

# 4. Analytics & Conversion Tracking (OPTIONAL)
# Leave empty if not configured yet; tracking remains safely disabled and site/build will succeed.
VITE_GA_MEASUREMENT_ID=""
VITE_META_PIXEL_ID=""

# 5. IndexNow Verification & Submission (OPTIONAL — Server-Side Only)
# Provide your own 8-128 character alphanumeric/hyphen key (e.g. from Bing Webmaster Tools).
# Leave empty to keep IndexNow safely disabled; build & main website work normally without it.
# Never prefix with VITE_. When set during Vercel build, /<INDEXNOW_KEY>.txt is generated automatically.
INDEXNOW_KEY=""

# 6. Supabase Service Role Key (OPTIONAL — Server-Side Secret Only, NEVER use VITE_)
# Leave empty unless specifically needed for privileged backend tasks or CRON outbox processing.
SUPABASE_SERVICE_ROLE_KEY=""

# 7. Authenticated Static Rebuild Hook & IndexNow Outbox Cron Secret (OPTIONAL — Server-Side Only)
VERCEL_DEPLOY_HOOK_URL=""
CRON_SECRET=""
INDEXNOW_CRON_ENABLED=""
