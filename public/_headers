# ==============================================================================
# Cloudflare Pages Custom HTTP Headers Configuration
# Documentation: https://developers.cloudflare.com/pages/configuration/headers/
# ==============================================================================

# Global Security and Content-Type Headers
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

# Static Fingerprinted Assets (CSS, JS) - 1 Year Immutable Cache
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Static Video Assets - 7 Days Cache
/videos/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# SEO and Robot files - 1 Day Cache
/sitemap.xml
  Cache-Control: public, max-age=86400
  Content-Type: application/xml; charset=utf-8

/robots.txt
  Cache-Control: public, max-age=86400
  Content-Type: text/plain; charset=utf-8

# HTML Documents - Instant Revalidation for Zero Stale Content
/index.html
  Cache-Control: public, max-age=0, must-revalidate
